# Application secrets
GEMINI_API_KEY=

# Transcription
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
WHISPER_GPU_COMPUTE_TYPE=int8_float16
WHISPER_CPU_COMPUTE_TYPE=int8

# Gemini models: set concrete supported IDs during implementation
GEMINI_CHUNK_MODEL=
GEMINI_CONSOLIDATION_MODEL=
GEMINI_PRO_MODEL=
USE_PRO_WHEN_AVAILABLE=false

# Source retention
DELETE_SOURCE_VIDEO_AFTER_SUCCESS=false

# Context7 is listed only as a reminder. OpenCode must receive this value
# from the Windows user environment before it starts; Python may also read it.
CONTEXT7_API_KEY=

